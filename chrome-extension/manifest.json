{
  "manifest_version": 3,
  "name": "Username Generator",
  "version": "1.2.0",
  "description": "Generate custom usernames with history, favorites, dark mode, and multi-language support",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icon.png"
    },
    "default_title": "Username Generator"
  },
  "permissions": ["storage"]
}
